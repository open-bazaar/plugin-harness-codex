{
  "id": "harness-codex",
  "name": "Codex",
  "description": "Official Codex CLI (app-server stdio JSON-RPC) harness plugin for Bazaar Compute Node",
  "kind": "harness",
  "version": "0.4.0-rc.1",
  "apiVersion": 1,
  "minHostVersion": "0.4.0-rc.1",
  "license": "Apache-2.0",
  "main": "index.lua",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "model": {
        "type": "string",
        "title": "Model",
        "description": "Optional Codex model override",
        "x-inspect": "models"
      },
      "effort": {
        "type": "string",
        "title": "Reasoning Effort",
        "description": "Optional Codex reasoning effort override",
        "x-inspect": "efforts"
      },
      "apiKey": {
        "type": "string",
        "title": "OpenAI API Key",
        "description": "Optional OPENAI_API_KEY override",
        "writeOnly": true
      },
      "startupTimeoutSec": {
        "type": "number",
        "title": "Startup Timeout (seconds)",
        "description": "Timeout in seconds for Codex app-server startup and RPC handshakes",
        "default": 60
      },
      "shutdownTimeoutSec": {
        "type": "number",
        "title": "Shutdown Timeout (seconds)",
        "description": "Timeout in seconds for graceful Codex app-server shutdown",
        "default": 5
      }
    }
  },
  "capabilities": [
    "inspect",
    "quota",
    "steer",
    "approval",
    "background_check"
  ],
  "permissions": {
    "exec": ["codex"]
  }
}
